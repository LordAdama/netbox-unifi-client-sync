# UniFi Controller connection
UNIFI_HOST=https://192.168.1.1
# Preferred: a local UniFi OS API key (Settings -> Control Plane ->
# Integrations -> API Keys). No session to expire, and it's a scoped
# credential instead of your admin password. Support depends on controller
# firmware version — verify with --dry-run. Leave blank to use
# UNIFI_USERNAME/UNIFI_PASSWORD instead.
UNIFI_API_KEY=
UNIFI_USERNAME=admin
UNIFI_PASSWORD=change-me
# Set true for UDM/UDM-Pro/CloudKey Gen2+ (UniFi OS), false for classic self-hosted controller
UNIFI_IS_UDM=true
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# NetBox connection
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=change-me
NETBOX_VERIFY_SSL=true
# NetBox site slug that UniFi clients/switches should be placed in
NETBOX_SITE_SLUG=main
# "require" (default, safe): fail if NETBOX_SITE_SLUG doesn't already exist.
# "create": create a minimal site if it's missing. Either way, an existing
# site's own attributes are never modified.
SITE_POLICY=require
# Status set on IP addresses this tool creates. Addresses are always created
# as bare /32s in the global table (no VRF/tenant support) — if you need
# either, you'll need to extend PynetboxGateway.assign_ip.
NETBOX_IP_STATUS=active

# Behavior
DRY_RUN=false
LOG_LEVEL=INFO
# "text" (human-readable) or "json" (one JSON object per log line, for log
# shippers). A JSON one-line run summary is always logged in addition,
# regardless of this setting — look for "sync_summary=".
LOG_FORMAT=text
SYNC_TAG=unifi-sync
CLIENT_DEVICE_ROLE_SLUG=unifi-client
CLIENT_MANUFACTURER_SLUG=generic
CLIENT_DEVICE_TYPE_SLUG=generic-network-client
# Comma-separated candidate interface-name templates tried in order on the switch,
# "{port}" is replaced with the UniFi switch port index (1-based).
PORT_NAME_TEMPLATES={port},Port {port},GE{port},Gi{port}
# What to do when the target switch interface is already cabled to something else:
# "skip" (default, non-destructive) or "replace"
CABLE_CONFLICT_POLICY=skip
# Mark previously-synced NetBox client devices as "offline" when UniFi no longer reports them
MARK_STALE_OFFLINE=true
# "sync" (default): keep an existing client device's name/status matched to
# UniFi. "create-only": set them once at creation and never touch them
# again, so a NetBox admin's manual renames/edits stick. Only affects the
# device's name/status — interfaces, IPs, and cables still sync either way.
DEVICE_UPDATE_POLICY=sync
# If set, write Prometheus textfile-collector metrics to this path after
# every run (see node_exporter's --collector.textfile.directory). Requires
# the path to be on a volume the container can write to. Leave blank to skip.
METRICS_FILE=

# Docker only: if unset/0, the container runs one sync and exits (pair with host cron).
# If set to a positive number, the container loops forever, syncing every N seconds.
SYNC_INTERVAL_SECONDS=3600
# Docker only, optional: path to an flock(1) lock file. Only useful if it
# lives on storage shared with another instance (a second container/host
# syncing the same NetBox) — this tool has no locking of its own otherwise,
# and instances that don't share this path aren't protected from each other.
LOCK_FILE=
