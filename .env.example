# UniFi Controller connection
UNIFI_HOST=https://192.168.1.1
# Preferred: a local UniFi OS API key (Settings -> Control Plane ->
# Integrations -> API Keys). No session to expire, and it's a scoped
# credential instead of your admin password. Support depends on controller
# firmware version — verify with --dry-run. Leave blank to use
# UNIFI_USERNAME/UNIFI_PASSWORD instead.
UNIFI_API_KEY=
UNIFI_USERNAME=admin
UNIFI_PASSWORD=change-me
# Set true for UDM/UDM-Pro/CloudKey Gen2+ (UniFi OS), false for classic self-hosted controller
UNIFI_IS_UDM=true
# UNIFI_SITE is only used when SITE_MAP (below) is empty.
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# NetBox connection
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=change-me
NETBOX_VERIFY_SSL=true
# NetBox site slug that UniFi clients/switches should be placed in. Only
# used when SITE_MAP (below) is empty — otherwise SITE_MAP wins entirely.
NETBOX_SITE_SLUG=main
# For syncing more than one UniFi site in a single run. When set, this
# replaces UNIFI_SITE and NETBOX_SITE_SLUG entirely (they're ignored).
#   SITE_MAP=default:main,branch-office:branch   explicit pairs
#   SITE_MAP=*                                   every site on the controller
#   SITE_MAP=*,default:head-office               all sites, one slug pinned
# With "*", NetBox slugs come from each site's description as shown in the
# UniFi UI ("Head Office" -> "head-office"). Existing sites are matched by a
# stored UniFi site id, then by slug/name, and are never renamed. Missing
# sites are reported, not created, unless SITE_POLICY=create.
SITE_MAP=
# "require" (default, safe): fail if a site can't be matched to one that
# already exists. "create" is an explicit opt-in that creates a minimal site
# when nothing matches. An existing site's name and slug are never modified.
# How an existing NetBox site is found for a UniFi site. A matched site is
# linked to and NEVER modified — its existing inventory stays put and the
# UniFi devices/clients are added alongside.
#   "normalized" (default) exact slug, then exact name, then both folded to
#                          alphanumerics, so "Acme's Depot - North Yard"
#                          links to an existing acmes-depot-north-yard
#                          rather than creating acme-s-depot-north-yard
#   "name"                 exact slug, then exact name
#   "slug"                 exact slug only (the original behavior)
SITE_MATCH=normalized
SITE_POLICY=require
# Status set on IP addresses this tool creates. Addresses are always created
# as bare /32s in the global table (no VRF/tenant support) — if you need
# either, you'll need to extend PynetboxGateway.assign_ip.
NETBOX_IP_STATUS=active

# Behavior
# true (default): log every intended create/update/delete and write nothing.
# Set false, or pass --apply, only after a dry-run looks right.
DRY_RUN=true
# Per-request HTTP timeouts, in seconds. NetBox calls have no timeout unless
# this is set; a stalled connection would otherwise hang the run forever.
# A NetBox read that times out or fails to connect is retried twice (1s,
# then 2s). Writes are not retried. HTTP 429 is retried separately, up to
# NETBOX_RATE_LIMIT_RETRIES, honoring Retry-After.
NETBOX_TIMEOUT=30
# Bulk-load NetBox devices and interfaces once per site and answer client
# MAC lookups from that index. true (default). false restores one device
# lookup per client.
NETBOX_PREFETCH=true
# Skip the write path when the prefetched client already matches UniFi.
# true (default). Creates, updates, skips, and offline marks stay the same.
NETBOX_FAST_PATH=true
# Page size for NetBox list calls. Must be a positive integer. NetBox often
# caps this at 1000.
NETBOX_PAGE_SIZE=1000
# How many NetBox HTTP calls may be in flight at once, across every site
# worker. 0 means no extra cap. A 429 wait does not hold a slot.
NETBOX_MAX_INFLIGHT=4
NETBOX_RATE_LIMIT_RETRIES=5
UNIFI_TIMEOUT=30
LOG_LEVEL=INFO
# "text" (human-readable) or "json" (one JSON object per log line, for log
# shippers). A JSON one-line run summary is always logged in addition,
# regardless of this setting — look for "sync_summary=".
LOG_FORMAT=text
SYNC_TAG=unifi-sync
CLIENT_DEVICE_ROLE_SLUG=unifi-client
# Roles whose placeholder interface (eth0 for wired, wlan0 for wireless) and
# IP this sync may write. Comma-separated. Leave unset to follow
# CLIENT_DEVICE_ROLE_SLUG. A device in any other role is matched by MAC, so
# no second device is created, and the pass logs one skip line: no eth0, no
# IP move, no cable on that interface. If you set the list, include
# CLIENT_DEVICE_ROLE_SLUG or later passes stop updating addresses on devices
# this sync created.
# MANAGED_CLIENT_ROLE_SLUGS=unifi-client,endpoint
# Per-device opt-out. A device with this tag is still matched by MAC (no
# duplicate) even when its role is a managed client role. Interfaces and the
# IP stay as they are. One log line per device per run. Use this for gear you
# built by hand and do not want a client eth0 added back.
SYNC_UNMANAGED_TAG=sync-unmanaged
# Fallback manufacturer/device type, used when the client's vendor can't be
# determined (unknown OUI, or a randomized MAC).
CLIENT_MANUFACTURER_SLUG=generic
CLIENT_DEVICE_TYPE_SLUG=generic-network-client
# Give each client a device type carrying its real manufacturer, taken from
# the MAC OUI the controller already resolves per client. Creates one zero-U
# device type per vendor, e.g. "Apple, Inc. Client".
USE_OUI_MANUFACTURER=true
# Optional IEEE oui.txt or Wireshark manuf file, consulted only for MACs the
# controller did not attribute. Leave blank to skip offline lookup.
OUI_FILE=
# Create adopted UniFi infrastructure (switches, APs, gateways, PDUs) in
# NetBox rather than requiring it to already be there. Off by default, since
# creating infrastructure is more invasive than creating clients. Turning
# this on generally makes cabling work with no further setup.
SYNC_UNIFI_DEVICES=false
# Optional local clone of https://github.com/netbox-community/devicetype-library.
# A match uses that YAML's model, part number, interfaces, power ports, and
# power outlets. No match falls back to the controller port_table / outlet_table.
# The image does not clone this unless built with FETCH_DEVICETYPE_LIBRARY=true,
# which lands it at /opt/devicetype-library. Mount a clone read-only instead:
#   git clone --depth 1 https://github.com/netbox-community/devicetype-library
DEVICETYPE_LIBRARY_PATH=
# Role for created UniFi devices whose kind isn't recognised.
UNIFI_DEVICE_ROLE_SLUG=network-device
# Per-kind roles. Defaults match earlier releases. Recommended when those
# roles already exist in NetBox: access-switch, wireless-access-point,
# gateway, pdu. An existing slug is reused and not created again.
UNIFI_SWITCH_ROLE_SLUG=switch
UNIFI_AP_ROLE_SLUG=wireless-ap
UNIFI_GATEWAY_ROLE_SLUG=router
UNIFI_POWER_ROLE_SLUG=pdu
# Convert a tagged unifi-client device (named by MAC, single eth0) into the
# adopted switch/AP/gateway/PDU with the same MAC, keeping the NetBox id.
# true is the default and the recommended value. false leaves that client
# device alone and does not create a duplicate. Happens even under
# DEVICE_UPDATE_POLICY=create-only.
MERGE_CLIENT_INFRA=true
# A gateway/router owns one MAC per port. UniFi often reports the extras as
# clients, and unifi_mac holds only one address, so those clients used to
# become placeholder devices named after the MAC.
# true (default): also treat unifi_macs (comma, semicolon, or whitespace
# separated) and interface hardware addresses (interface mac_address, or a
# MAC address object on that interface) as belonging to that device. A client
# that presents one of them is not created, and its IP is not copied onto
# the owner. The exact unifi_mac match is unchanged and still wins.
# false: previous behaviour, exact unifi_mac only.
# The interface mac_address join used to find a switch stays on either way.
MATCH_OWNED_MACS=true
# A same-site name can already belong to a different device: another vendor,
# a hand-made record whose serial is an old MAC, or a second UniFi device
# that was given the same name. The default skips that UniFi device, logs
# the reason, and counts it in infra_name_conflicts. It does not create a
# MAC-suffixed duplicate. true creates the UniFi device under a name ending
# in the MAC's last four hex digits and still leaves the existing device
# unchanged.
CREATE_SUFFIXED_ON_NAME_CONFLICT=false
# UniFi sites whose adopted devices are inventory/staging stock. Comma-
# separated short API names and/or controller _id values. Empty disables it.
# An inventory sighting never duplicates a device that exists elsewhere and
# never pulls one off a real site. A later adoption at a real site moves it.
UNIFI_INVENTORY_SITES=
# NetBox status for devices created from an inventory site.
# offline, active, planned, staged, failed, inventory, decommissioning.
INVENTORY_DEVICE_STATUS=inventory
# Comma-separated candidate interface-name templates tried in order against
# the switch's real interface names; "{port}" is the UniFi port index.
# Leave blank for the built-in list, which covers "Port 1", "1", "GE1",
# "Gi1", "eth1", "Ethernet1", "GigabitEthernet1", "Port1" and "port1".
# If cables are being skipped, set CABLE_SKIP_REPORT and read that CSV.
# The built-in list plus a structural match already covers "Port 1", "1",
# "GE1", "Gi1", "Gi1/0/1", "1/1/1", "ge-0/0/1", zero-padded forms, and
# SFP ordinals ("SFP 1") when the controller says the port is an SFP.
# "{port}" is the UniFi port index. "{port2}" / "{port:02d}" are zero-padded.
# "{sfp}" is the 1-based SFP ordinal (port 25 on a 24+SFP switch is SFP 1).
PORT_NAME_TEMPLATES=
# Per UniFi model, tried before PORT_NAME_TEMPLATES. Use this when a switch
# has two interfaces that both end in the same port number (stack members)
# and the structural match would be ambiguous. Templates inside one model
# are separated by ";". Models are separated by "|". Model text is folded,
# so "USW-Pro-48" matches "USWPro48". A model that has templates does not
# get the structural guess — the templates are the scheme for that model.
#   USW-Pro-48=Gi1/0/{port};SFP {sfp}|EX2300=ge-0/0/{port}
PORT_MODEL_TEMPLATES=
# CSV of every skipped cable (site, switch, UniFi port, names tried, NetBox
# interface names, reason) plus a count-by-reason line in the log. Written
# on dry-run too; it is not a NetBox change. Leave blank to log only.
CABLE_SKIP_REPORT=
# What to do when the target switch interface is already cabled to something else:
# "skip" (default, non-destructive) or "replace". replace is opt-in and only
# deletes cables this tool tagged with SYNC_TAG; manual cables are kept.
CABLE_CONFLICT_POLICY=skip
# Mark client devices this tool created (SYNC_TAG + the client role) as
# "offline" when UniFi last_seen is older than STALE_OFFLINE_GRACE. Being
# absent from the active list is not enough — idle phones and laptops drop
# out of that list and come back. Never touches infrastructure devices or
# objects that do not carry SYNC_TAG. The status change is a PATCH of
# status only; the rest of the device record is not written.
MARK_STALE_OFFLINE=true
# How long a client may be idle before it is marked offline. Compared to
# last_seen from the controller's client history. 7d, 24h, 30m, or seconds.
# 0 marks as soon as last_seen is in the past. Randomized phone MACs use
# the same window; past it, that address will not come back.
STALE_OFFLINE_GRACE=7d
# "create-only" (default): set a managed device's name/status once, at
# creation. "sync" keeps them matched to UniFi and will revert renames made
# in NetBox, so it is opt-in. Either value only applies to objects tagged
# SYNC_TAG; untagged devices are never modified.
DEVICE_UPDATE_POLICY=create-only
# If set, write Prometheus textfile-collector metrics to this path after
# every run (see node_exporter's --collector.textfile.directory). Requires
# the path to be on a volume the container can write to. Leave blank to skip.
METRICS_FILE=
# How many NetBox sites to sync concurrently. Default 4. Set 1 for a
# strictly sequential run. Only distinct NetBox sites run in parallel —
# pairs that share a site always run together, on one worker. The practical
# ceiling is whatever your NetBox instance tolerates; NETBOX_MAX_INFLIGHT
# caps the HTTP calls those workers make. Raise gradually and watch the
# per-site timings logged at the end of the run.
MAX_WORKERS=4

# Docker only: if unset/0, the container runs one sync and exits (pair with host cron).
# If set to a positive number, the container loops forever, syncing every N seconds.
SYNC_INTERVAL_SECONDS=3600
# Docker only, optional: path to an flock(1) lock file. Only useful if it
# lives on storage shared with another instance (a second container/host
# syncing the same NetBox) — this tool has no locking of its own otherwise,
# and instances that don't share this path aren't protected from each other.
LOCK_FILE=
